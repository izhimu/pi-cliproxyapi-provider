{
	"name": "@izhimu/pi-cliproxyapi-provider",
	"version": "1.4.19-1",
	"description": "Pi provider extension that auto-registers CLIProxyAPI models, plus TUI elapsed/TPS status",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"omp-package",
		"omp-extension",
		"cliproxyapi",
		"tps"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/izhimu/pi-cliproxyapi-provider.git"
	},
	"homepage": "https://github.com/izhimu/pi-cliproxyapi-provider#readme",
	"bugs": {
		"url": "https://github.com/izhimu/pi-cliproxyapi-provider/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "npm run typecheck && npm run lint && npm run test"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts",
			"./extensions/tps.ts"
		]
	},
	"omp": {
		"extensions": [
			"./extensions/index.ts",
			"./extensions/tps.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": ">=0.82.0",
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-coding-agent": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@types/node": "^22.15.21",
		"typescript": "6.0.3",
		"vitest": "4.1.9"
	},
	"files": [
		"extensions",
		"README.md",
		"LICENSE"
	]
}
